,CAAC,CAAC,CAAC,KAAK,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC,KAAK,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;AAC9C,CAAC,CAAC,CAAC,CAAC,iCAAO,GAAG,CAAC,CAAC,IAAI,CAAC,KAAK,CAAC;AAC3B,CAAC,CAAC,CAAC,CAAC,iCAAO,IAAI,CAAC,QAAQ,CAAC,CAAC,SAAS,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;AAC/C,CAAC,CAAC,CAAC,CAAC,IAAI,CAAC,cAAc,CAAC,CAAC;AACzB,CAAC,CAAC,CAAC,CAAC,iCAAO,IAAI,CAAC,IAAI,CAAC,CAAC,QAAQ,CAAC,CAAC;AAChC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,MAAM,CAAC,CAAC,CAAC,IAAI,CAAC,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,CAAC,IAAI,CAAC,CAAC,CAAC;AACvC,CAAC,CAAC,CAAC,CAAC,KAAK,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC,KAAK,CAAC,CAAC,CAAC,CAAC,IAAI,CAAC,IAAI,CAAC,IAAI,CAAC,IAAI,CAAC,CAAC;AACpD,CAAC,CAAC,CAAC,CAAC,KAAK,CAAC,IAAI,CAAC,MAAM,CAAC,CAAC;AACvB,CAAC,CAAC,CAAC,CAAC,iCAAO,IAAI,CAAC,IAAI,CAAC,CAAC,QAAQ,CAAC,CAAC;AAChC,CAAC,CAAC,CAAC,CAAC;AACJ,CAAC,CAAC","names":[],"ignoreList":[],"sources":["LoginView.test.js"],"sourcesContent":["// 登录门禁回归（v7.0.14）：App 根 auth 流程 + LoginView 交互。\n//\n// mock 点：api client（零网络）。流程契约：\n// - 启动 → GET /api/auth/me：401 → 渲染登录页；200 → 直进 AppShell；\n// - 登录提交（表单默认/回车）→ POST /api/login：成功 → AppShell 挂载\n//   + taskStore.restore（/api/health）；失败 → 行内错误文案，停留登录页；\n// - 运行中任意受保护 API 401 → client 发 auth:401 → 回登录页；\n// - 顶栏「退出」→ POST /api/logout → 回登录页。\nimport { beforeEach, describe, expect, it, vi } from \"vitest\";\nimport { flushPromises, mount } from \"@vue/test-utils\";\nimport { createPinia } from \"pinia\";\n\nconst apiMock = vi.fn();\nvi.mock(\"../../api/client.js\", () => ({\n  api: (...a) => apiMock(...a),\n  isBackfillErr: (e) => !!(e && e.status === 409 && e.body && e.error === \"lake_backfill_in_progress\"),\n}));\n\nconst App = (await import(\"../../App.vue\")).default;\nconst { useAuthStore } = await import(\"../../stores/authStore.js\");\n\nfunction mockApi({ me = 401 } = {}) {\n  apiMock.mockImplementation(async (path, opts = {}) => {\n    if (path === \"/api/auth/me\") {\n      if (me === 401) {\n        const e = new Error(\"未登录或会话已过期\");\n        e.status = 401;\n        throw e;\n      }\n      return { user: \"admin\" };\n    }\n    if (path === \"/api/login\" && opts.method === \"POST\") {\n      const b = JSON.parse(opts.body);\n      if (b.username === \"admin\" && b.password === \"unit-test-only-pass\") return { ok: true, user: \"admin\" };\n      const e = new Error(\"用户名或密码错误\");\n      e.status = 401;\n      throw e;\n    }\n    if (path === \"/api/logout\" && opts.method === \"POST\") return { ok: true };\n    if (path === \"/api/health\") return { ok: true, active_task: null };\n    throw new Error(\"unmocked: \" + path);\n  });\n}\n\nconst mk = () => mount(App, { attachTo: document.body, global: { plugins: [createPinia()] } });\nconst isLogin = (w) => !!w.find(\".login-card\").exists();\nconst isShell = (w) => w.find(\".topbar .brand\").exists();\n\nbeforeEach(() => {\n  apiMock.mockReset();\n  mockApi();\n});\n\ndescribe(\"App 登录门禁\", () => {\n  it(\"未登录（me 401）→ 登录页；双入口按钮在位（v7.0.43 恢复）；加载态不渲染页签\", async () => {\n    const w = mk();\n    expect(isLogin(w)).toBe(false); // checked=false 加载中\n    await flushPromises();\n    expect(isLogin(w)).toBe(true);\n    expect(w.find(\".login-title\").text()).toContain(\"马丁格尔\");\n    expect(w.find(\".login-btn-stock\").exists()).toBe(true);\n    expect(w.find(\".login-btn-crypto\").exists()).toBe(true);\n    w.unmount();\n  });\n\n  it(\"me 200（cookie 有效刷新）→ 直进主页\", async () => {\n    mockApi({ me: 200 });\n    const w = mk();\n    await flushPromises();\n    expect(isShell(w)).toBe(true);\n    w.unmount();\n  });\n\n  it(\"登录成功 → 主页；登录失败 → 停留登录页 + 错误文案\", async () => {\n    const w = mk();\n    await flushPromises();\n    expect(isLogin(w)).toBe(true);\n    // 失败\n    await w.find('input[autocomplete=\"username\"]').setValue(\"admin\");\n    await w.find('input[type=\"password\"]').setValue(\"wrong\");\n    await w.find(\"form.login-card\").trigger(\"submit\");\n    await flushPromises();\n    expect(isLogin(w)).toBe(true);\n    expect(w.find(\".login-err\").text()).toContain(\"用户名或密码错误\");\n    // 成功（A股按钮 = 表单提交）→ 直进主页\n    await w.find('input[type=\"password\"]').setValue(\"unit-test-only-pass\");\n    await w.find(\"form.login-card\").trigger(\"submit\");\n    await flushPromises();\n    expect(isShell(w)).toBe(true);\n    expect(w.find(\".topbar-user\").text()).toContain(\"admin\");\n    // taskStore.restore 已走 /api/health\n    expect(apiMock.mock.calls.some(([p]) => p === \"/api/health\")).toBe(true);\n    w.unmount();\n  });\n\n  it(\"运行中 auth:401 事件 → 回登录页\", async () => {\n    mockApi({ me: 200 });\n    const w = mk();\n    await flushPromises();\n    expect(isShell(w)).toBe(true);\n    window.dispatchEvent(new CustomEvent(\"auth:401\"));\n    await flushPromises();\n    expect(isLogin(w)).toBe(true);\n    w.unmount();\n  });\n\n  it(\"顶栏退出 → POST /api/logout → 回登录页\", async () => {\n    mockApi({ me: 200 });\n    const w = mk();\n    await flushPromises();\n    await w.find(\".topbar-logout\").trigger(\"click\");\n    await flushPromises();\n    expect(apiMock.mock.calls.some(([p, o]) => p === \"/api/logout\" && (o || {}).method === \"POST\")).toBe(true);\n    expect(isLogin(w)).toBe(true);\n    w.unmount();\n  });\n});\n\ndescribe(\"authStore 单元\", () => {\n  it(\"check/login/logout/onUnauthorized 状态迁移\", async () => {\n    mockApi({ me: 401 });\n    const pinia = createPinia();\n    const auth = useAuthStore(pinia);\n    await auth.check();\n    expect(auth.user).toBeNull();\n    expect(auth.checked).toBe(true);\n    const ok = await auth.login(\"admin\", \"unit-test-only-pass\");\n    expect(ok).toBe(true);\n    expect(auth.user).toBe(\"admin\");\n    const bad = await auth.login(\"admin\", \"x\");\n    expect(bad).toBe(false);\n    expect(auth.loginErr).toContain(\"用户名或密码错误\");\n    auth.onUnauthorized();\n    expect(auth.user).toBeNull();\n    // logout 走 POST（me 200 场景下 user 在位）\n    await auth.login(\"admin\", \"unit-test-only-pass\");\n    await auth.logout();\n    expect(auth.user).toBeNull();\n  });\n});\n"],"file":"/frontend/src/views/__tests__/LoginView.test.js"}