# Python
__pycache__/
*.pyc
.pytest_cache/

# 虚拟环境（uv 创建，本地重建：uv venv && uv sync）
.venv/

# 本地密钥（Tushare token 等，绝不入库）
.env

# 运行时数据（不入库；首次运行自动拉取，约 84MB）
cache/
logs/
output/

# v5.2 Phase 1：raw/canonical 数据层（append-only 审计 + 派生 Schema；回滚=整删）。
# ⚠️必须锚定仓库根 /data/——裸 data/ 会误伤 screener/data/ 源码目录。
/data/

# 团队流水线工作区产物（researcher/coder/tester 以 repo 为 cwd 时会把 stages/ 落到这里；
# 正式交付物在 ~/.hermes/joint_project/<task>/stages/，此处仅为成员运行副产物，不入库）。
/stages/
